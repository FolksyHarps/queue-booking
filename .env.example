# Copy this file to .env before the first `docker compose up`:
#   PowerShell / cmd:  copy .env.example .env
#   bash:              cp .env.example .env
# .env is git-ignored. The values below are placeholders for running locally;
# change them (especially JWT_SECRET) for any real deployment.
# Use letters, digits, '-' and '_' only.

# PostgreSQL superuser (only used by the postgres container)
POSTGRES_PASSWORD=change-me-postgres

# One login role per service database (created on the first start)
AUTH_DB_PASSWORD=change-me-auth-db
SERVICE_DB_PASSWORD=change-me-service-db
BOOKING_DB_PASSWORD=change-me-booking-db
NOTIFICATION_DB_PASSWORD=change-me-notification-db

# Signs and verifies login tokens (auth-service)
JWT_SECRET=change-me-to-a-long-random-string

# Shared key for internal service-to-service calls (header X-Internal-Key)
INTERNAL_API_KEY=change-me-internal-key

# Bootstrap admin account, created on the first start of auth-service
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
